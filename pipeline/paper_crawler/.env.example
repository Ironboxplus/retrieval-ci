# ============================================
# Paper Crawler 配置文件模板
# ============================================
# 将此文件复制为 .env 并填写相应的配置值
# cp .env.example .env

# ============================================
# 调试模式
# ============================================
DEBUG=false

# ============================================
# 代理配置
# ============================================
# 是否启用代理
PROXY_ENABLED=false

# HTTP 代理地址
# PROXY_HTTP=http://127.0.0.1:7890

# HTTPS 代理地址
# PROXY_HTTPS=http://127.0.0.1:7890

# SOCKS5 代理地址
# PROXY_SOCKS5=socks5://127.0.0.1:7891

# ============================================
# 下载配置
# ============================================
# 最大并发下载数 (1-20)
DOWNLOAD_MAX_CONCURRENT=5

# 最大重试次数 (0-10)
DOWNLOAD_MAX_RETRIES=3

# 重试延迟（秒）
DOWNLOAD_RETRY_DELAY=1.0

# 重试延迟倍数（指数退避）
DOWNLOAD_RETRY_BACKOFF=2.0

# 连接超时（秒）
DOWNLOAD_CONNECT_TIMEOUT=10.0

# 读取超时（秒）
DOWNLOAD_READ_TIMEOUT=60.0

# 总超时（秒）
DOWNLOAD_TOTAL_TIMEOUT=300.0

# 请求间隔（秒）
DOWNLOAD_REQUEST_DELAY=1.0

# 下载块大小（字节）
DOWNLOAD_CHUNK_SIZE=8192

# 是否覆盖已存在的文件
DOWNLOAD_OVERWRITE_EXISTING=false

# ============================================
# API 密钥配置
# ============================================
# Semantic Scholar API Key
# 申请地址: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=your_api_key_here

# arXiv API Key (目前不需要)
# ARXIV_API_KEY=

# Crossref API Key
# CROSSREF_API_KEY=your_api_key_here

# Crossref Polite Pool 邮箱
# 使用邮箱可以获得更高的请求配额
# CROSSREF_EMAIL=your_email@example.com

# Unpaywall API 邮箱
# 申请地址: https://unpaywall.org/products/api
# UNPAYWALL_EMAIL=your_email@example.com

# CORE API Key
# 申请地址: https://core.ac.uk/services/api
# CORE_API_KEY=your_api_key_here

# Elsevier API Key
# 申请地址: https://dev.elsevier.com/
# ELSEVIER_API_KEY=your_api_key_here

# Springer Nature API Key
# 申请地址: https://dev.springernature.com/
# SPRINGER_API_KEY=your_api_key_here

# IEEE Xplore API Key
# 申请地址: https://developer.ieee.org/
# IEEE_API_KEY=your_api_key_here

# OpenAI API Key (用于 PDF 解析等)
# OPENAI_API_KEY=your_api_key_here

# Mathpix API (用于公式识别)
# 申请地址: https://mathpix.com/
# MATHPIX_APP_ID=your_app_id_here
# MATHPIX_APP_KEY=your_app_key_here

# ============================================
# 存储路径配置
# ============================================
# 数据根目录 (默认: ./data)
# STORAGE_DATA_DIR=./data

# PDF 存储目录 (默认: ./data/papers/pdf)
# STORAGE_PDF_DIR=./data/papers/pdf

# Markdown 存储目录 (默认: ./data/papers/markdown)
# STORAGE_MARKDOWN_DIR=./data/papers/markdown

# 元数据存储目录 (默认: ./data/papers/metadata)
# STORAGE_METADATA_DIR=./data/papers/metadata

# 日志目录 (默认: ./data/logs)
# STORAGE_LOG_DIR=./data/logs

# 缓存目录 (默认: ./data/cache)
# STORAGE_CACHE_DIR=./data/cache

# 临时目录 (默认: ./data/temp)
# STORAGE_TEMP_DIR=./data/temp

# ============================================
# 日志配置
# ============================================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 是否输出到控制台
LOG_CONSOLE=true

# 是否输出到文件
LOG_FILE=true

# 日志轮转时间 (每天午夜)
LOG_ROTATION=00:00

# 日志保留时间
LOG_RETENTION=30 days

# 日志压缩格式
LOG_COMPRESSION=zip

# ============================================
# 爬虫配置
# ============================================
# User-Agent 字符串
# SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# 是否遵守 robots.txt
SCRAPER_RESPECT_ROBOTS_TXT=true

# 默认最大搜索结果数量
SCRAPER_DEFAULT_MAX_RESULTS=100

# 是否自动下载 PDF
SCRAPER_AUTO_DOWNLOAD_PDF=true

# 是否自动转换为 Markdown
SCRAPER_AUTO_CONVERT_MARKDOWN=true
