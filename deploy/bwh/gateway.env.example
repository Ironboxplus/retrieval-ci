# Copy to BWH as ~/docker/retrieval/gateway.env (chmod 600, NEVER commit).
# Generate the four secrets with:  openssl rand -hex 32   (and sk- prefix for the root key)
# The gateway reads these via env_prefix=GATEWAY_.

# app-tier DB — lives in the /data volume (compose mounts ./gateway-data)
GATEWAY_DB_URL=sqlite:////data/gateway.db

# === secrets — REGENERATE, do not reuse these placeholders ===
GATEWAY_KEY_PEPPER=__openssl_rand_hex_32__
GATEWAY_SESSION_SECRET=__openssl_rand_hex_32__
GATEWAY_ADMIN_ROOT_KEY=sk-__openssl_rand_hex_32__
GATEWAY_INTERNAL_TOKEN=__openssl_rand_hex_32__

# === OIDC (cf-oidc Worker 116 — already live, accepts any https redirect/client) ===
GATEWAY_OIDC_ISSUER=https://116.ironbox.workers.dev
GATEWAY_OIDC_CLIENT_ID=retrival-web
GATEWAY_OIDC_REDIRECT_URI=https://retrieval.rnarket.com/auth/callback

# === social login: linux.do Connect (account binding shares one balance) ===
# App "paperR" @ connect.linux.do. Callback MUST equal the app's configured redirect.
# Leave client_id BLANK to disable this login method. Secrets: BWH only, NEVER git.
GATEWAY_LINUXDO_CLIENT_ID=__linuxdo_connect_client_id__
GATEWAY_LINUXDO_CLIENT_SECRET=__linuxdo_connect_client_secret__
GATEWAY_LINUXDO_REDIRECT_URI=https://retrieval.rnarket.com/api/linuxdooid/callback
GATEWAY_LINUXDO_MIN_TRUST_LEVEL=0     # reject logins below this LD trust level (0 = allow all)

# === social login: Google OAuth (OIDC userinfo) ===
# Google Cloud Console OAuth client. Its Authorized redirect URI MUST be the
# google-specific path below (NOT the linux.do one). Blank client_id = disabled.
GATEWAY_GOOGLE_CLIENT_ID=__google_oauth_client_id__
GATEWAY_GOOGLE_CLIENT_SECRET=__google_oauth_client_secret__
GATEWAY_GOOGLE_REDIRECT_URI=https://retrieval.rnarket.com/api/google/callback

# === compute (4090) — reached through the SAME tunnel portal container ===
# NOT 127.0.0.1: in docker the gateway talks to the tunnel by service name.
GATEWAY_INTERNAL_BASE_URL=http://retrieval-xray:18000

# === billing / payment (mock until a real epay/ldc provider is wired) ===
GATEWAY_SEARCH_COST=1
GATEWAY_PAYMENT_SECRET=__epay_or_ldc_merchant_secret__
GATEWAY_PAYMENT_NOTIFY_URL=https://retrieval.rnarket.com/api/payment/notify
GATEWAY_PUBLIC_BASE_URL=https://retrieval.rnarket.com
