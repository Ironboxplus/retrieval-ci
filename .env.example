# Retrieval System 环境变量配置

# 代理配置
PROXY__ENABLED=false
PROXY__HTTP_PROXY=http://127.0.0.1:7890
PROXY__HTTPS_PROXY=http://127.0.0.1:7890

# 嵌入模型配置
EMBEDDING__MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING__MAX_TOKENS=512
EMBEDDING__BATCH_SIZE=32

# 分块配置
# CHUNK__CHUNK_SIZES=[512, 256, 128]
CHUNK__CHUNK_OVERLAP=50
CHUNK__SUMMARY_MAX_LENGTH=500

# 检索配置
RETRIEVAL__INITIAL_TOP_K=1000
RETRIEVAL__FINAL_TOP_N=20
RETRIEVAL__BM25_WEIGHT=0.3
RETRIEVAL__VECTOR_WEIGHT=0.7

# 爬虫配置
CRAWLER__HEADLESS=true
CRAWLER__TIMEOUT=30000
CRAWLER__MAX_CONCURRENT=5
CRAWLER__RETRY_TIMES=3
CRAWLER__DELAY_BETWEEN_REQUESTS=1.0
