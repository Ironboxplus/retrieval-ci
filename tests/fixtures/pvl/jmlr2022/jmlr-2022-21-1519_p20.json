    ],
    "block_content": " $$ \\operatorname*{s u p}_{(P,Q)\\in\\Pi}\\mathbb{E}\\big[\\mathcal{E}_{Q}(\\hat{f})\\big]\\geq c n_{Q}^{-\\frac{1+\\alpha}{2}}. $$ "
   },
   {
