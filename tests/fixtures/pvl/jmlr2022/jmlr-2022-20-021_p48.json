    ],
    "block_content": " $$ \\begin{align*}\\|\\operatorname{cov}(\\boldsymbol{c}_{k})\\|_{\\max}&\\leq\\max_{1\\leq i\\leq p_{k}}|\\operatorname{var}(\\boldsymbol{c}_{k}^{[i]})|\\\\&=\\max_{1\\leq i\\leq p_{k}}|\\mathbf{V}_{x k}^{[i,:]}\\boldsymbol{\\Lambda}_{x k}^{1/2}\\mathbf{H}_{k}^{\\top}[\\operatorname{cov}(\\boldsymbol{z}_{k}^{\\mathcal{I}_{0}})]^{\\dagger}\\mathbf{A}\\mathbf{N}\\operatorname{cov}(\\boldsymbol{f})(\\mathbf{V}_{x k}^{[i,:]}\\boldsymbol{\\Lambda}_{x k}^{1/2}\\mathbf{H}_{k}^{\\top}[\\operatorname{cov}(\\boldsymbol{z}_{k}^{\\mathcal{I}_{0}})]^{\\dagger}\\mathbf{A}\\mathbf{N})^{\\top}|\\\\&\\leq\\max_{1\\leq i\\leq p_{k}}\\{\\|\\mathbf{V}_{x k}^{[i,:]}\\boldsymbol{\\Lambda}_{x k}^{1/2}\\|_{2}^{2}\\|\\mathbf{H}_{k}^{\\top}[\\operatorname{cov}(\\boldsymbol{z}_{k}^{\\mathcal{I}_{0}})]^{\\dagger}\\mathbf{A}\\mathbf{N}\\operatorname{cov}(\\boldsymbol{f})(\\mathbf{H}_{k}^{\\top}[\\operatorname{cov}(\\boldsymbol{z}_{k}^{\\mathcal{I}_{0}})]^{\\dagger}\\mathbf{A}\\mathbf{N})^{\\top}\\|_{2}\\\\&\\lesssim_{P}\\max_{1\\leq i\\leq p_{k}}\\|\\mathbf{V}_{x k}^{[i,:]}\\boldsymbol{\\Lambda}_{x k}^{1/2}\\|_{2}^{2}\\leq\\max_{1\\leq i\\leq p_{k}}\\|\\mathbf{V}_{x k}^{[i,:]}\\boldsymbol{\\Lambda}_{x k}^{1/2}\\|_{\\max}^{2}r_{k}\\\\&\\lesssim_{P}\\lambda_{k,1}/p_{k}.\\end{align*} $$ "
