    ],
    "block_content": " $$ \\begin{aligned}&\\|\\widetilde{\\mathrm{cov}}(\\boldsymbol{c}_{k})-\\mathrm{cov}(\\boldsymbol{c}_{k})\\|_{\\max}\\\\&=\\|\\widehat{\\mathrm{cov}}(\\boldsymbol{x}_{k},\\boldsymbol{z}_{k}^{I_{0}})\\{\\widehat{\\mathrm{cov}}(\\boldsymbol{z}_{k}^{I_{0}})\\}^{\\dagger}n^{-1}\\widehat{\\mathbf{C}}^{I_{0}}(\\widehat{\\mathbf{C}}^{I_{0}})^{\\top}(\\widehat{\\mathrm{cov}}(\\boldsymbol{x}_{k},\\boldsymbol{z}_{k}^{I_{0}})\\{\\widehat{\\mathrm{cov}}(\\boldsymbol{z}_{k}^{I_{0}})\\}^{\\dagger})^{\\top}\\\\&\\quad-\\mathrm{cov}(\\boldsymbol{x}_{k},\\boldsymbol{z}_{k}^{I_{0}})\\{\\mathrm{cov}(\\boldsymbol{z}_{k}^{I_{0}})\\}^{\\dagger}\\mathrm{cov}(\\boldsymbol{e}^{I_{0}})(\\mathrm{cov}(\\boldsymbol{x}_{k},\\boldsymbol{z}_{k}^{I_{0}})\\{\\mathrm{cov}(\\boldsymbol{z}_{k}^{I_{0}})\\}^{\\dagger})^{\\top}\\|_{\\max}\\\\&\\leq\\|\\mathrm{cov}(\\boldsymbol{x}_{k},\\boldsymbol{z}_{k}^{I_{0}})\\{\\mathrm{cov}(\\boldsymbol{z}_{k}^{I_{0}})\\}^{\\dagger}\\mathrm{cov}(\\boldsymbol{e}^{I_{0}})\\|_{\\max}|\\mathcal{I}_{0}|\\delta_{B_{k}}+\\delta_{B_{k}\\Sigma_{c}}|\\mathcal{I}_{0}|\\|\\widehat{\\mathrm{cov}}(\\boldsymbol{x}_{k},\\boldsymbol{z}_{k}^{I_{0}})\\{\\widehat{\\mathrm{cov}}(\\boldsymbol{z}_{k}^{I_{0}})\\}^{\\dagger}\\|_{\\max}\\\\&\\lesssim_{P}(\\lambda_{k,1}/p_{k})^{1/2}[(\\lambda_{k,1}/p_{k})^{1/2}\\delta_{\\eta}+\\delta_{V_{k}}\\lambda_{k,1}^{1/2}]\\\\&\\quad+[(\\lambda_{k,1}/p_{k})^{1/2}\\delta_{\\eta}+\\delta_{V_{k}}\\lambda_{k,1}^{1/2}][(\\lambda_{k,1}/p_{k})^{1/2}+(\\lambda_{k,1}/p_{k})^{1/2}\\delta_{\\eta}+\\delta_{V_{k}}\\lambda_{k,1}^{1/2}]\\\\&\\lesssim_{P}[(\\lambda_{k,1}/p_{k})^{1/2}\\delta_{\\eta}+\\delta_{V_{k}}\\lambda_{k,1}^{1/2}](\\lambda_{k,1}/p_{k})^{1/2}.\\tag{85}\\end{aligned} $$ "
