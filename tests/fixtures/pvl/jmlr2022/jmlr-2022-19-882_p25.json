     1075
    ],
    "block_content": " $$ \\begin{align*}p(\\Sigma\\mid\\boldsymbol{H}_{t-1}^{T})&\\sim IW(\\Xi_{t-1},\\upsilon_{t-1})\\\\p(\\Theta_{t-1}\\mid\\Sigma,\\boldsymbol{H}_{t-1}^{T})&\\sim N(M_{t-1},C_{t-1},\\Sigma)\\end{align*} $$ "
   },
