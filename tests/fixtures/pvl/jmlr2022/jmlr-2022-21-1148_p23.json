    "block_content": " $$ \\begin{aligned}&\\operatorname{vec}(\\Delta\\mathbf{x},\\Delta\\mathbf{y})^{\\top}\\nabla^{2}f_{\\operatorname{clean}}(\\mathbf{X},\\mathbf{Y})\\operatorname{vec}(\\Delta\\mathbf{x},\\Delta\\mathbf{y})-4\\langle\\nabla f_{\\operatorname{clean}}(\\mathbf{X},\\mathbf{Y}),\\operatorname{vec}(\\Delta\\mathbf{x},\\Delta\\mathbf{y})\\rangle\\\\ \\leq&\\frac{1}{4}\\left\\{\\left\\|\\Delta\\mathbf{z}\\Delta\\mathbf{\\Sigma}_{\\mathbf{Z}}^{\\top}\\right\\|_{F}^{2}-3\\left\\|\\mathbf{Z}\\mathbf{Z}^{\\top}-\\mathbf{W}\\mathbf{W}^{\\top}\\right\\|_{F}^{2}\\right\\}+\\left(\\frac{1}{p}\\left\\|\\mathcal{P}_{\\Omega}\\left(\\Delta\\mathbf{x}\\Delta\\mathbf{\\Sigma}_{\\mathbf{Y}}^{\\top}\\right)\\right\\|_{F}^{2}-\\|\\Delta\\mathbf{x}\\Delta\\mathbf{\\Sigma}_{\\mathbf{Y}}^{\\top}\\|_{F}^{2}\\right)\\\\ &-\\left(\\frac{3}{p}\\left\\|\\mathcal{P}_{\\Omega}\\left(\\mathbf{X}\\mathbf{Y}^{\\top}-\\mathbf{U}\\mathbf{V}^{\\top}\\right)\\right\\|_{F}^{2}-3\\|\\mathbf{X}\\mathbf{Y}^{\\top}-\\mathbf{U}\\mathbf{V}^{\\top}\\|_{F}^{2}\\right)\\\\ &+\\lambda\\left[\\operatorname{vec}(\\Delta\\mathbf{x})^{\\top}\\nabla^{2}G_{\\alpha}(\\mathbf{X})\\operatorname{vec}(\\Delta\\mathbf{x})-4\\left\\langle\\nabla G_{\\alpha}(\\mathbf{X}),\\Delta\\mathbf{x}\\right\\rangle\\right]\\\\ &+\\lambda\\left[\\operatorname{vec}(\\Delta\\mathbf{y})^{\\top}\\nabla^{2}G_{\\alpha}(\\mathbf{Y})\\operatorname{vec}(\\Delta\\mathbf{y})-4\\left\\langle\\nabla G_{\\alpha}(\\mathbf{Y}),\\Delta\\mathbf{y}\\right\\rangle\\right].\\end{aligned} $$ "
