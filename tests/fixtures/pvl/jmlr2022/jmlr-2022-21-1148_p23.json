\top}-\\boldsymbol{U}\\boldsymbol{V}^{\\top}\\right)\\right\\|_{F}^{2}-3\\|\\boldsymbol{X}\\boldsymbol{Y}^{\\top}-\\boldsymbol{U}\\boldsymbol{V}^{\\top}\\|_{F}^{2}\\right)\\\\&+\\lambda\\left[\\operatorname{vec}(\\Delta_{\\boldsymbol{X}})^{\\top}\\nabla^{2}G_{\\alpha}(\\boldsymbol{X})\\operatorname{vec}(\\Delta_{\\boldsymbol{X}})-4\\left\\langle\\nabla G_{\\alpha}(\\boldsymbol{X}),\\Delta_{\\boldsymbol{X}}\\right\\rangle\\right]\\\\&+\\lambda\\left[\\operatorname{vec}(\\Delta_{\\boldsymbol{Y}})^{\\top}\\nabla^{2}G_{\\alpha}(\\boldsymbol{Y})\\operatorname{vec}(\\Delta_{\\boldsymbol{Y}})-4\\left\\langle\\nabla G_{\\alpha}(\\boldsymbol{Y}),\\Delta_{\\boldsymbol{Y}}\\right\\rangle\\right].\\end{aligned} $$ "
